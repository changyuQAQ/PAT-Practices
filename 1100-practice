bool cmp(string s1,string s2)
{
	int a = stoi(s1.substr(7, 7)); int b = stoi(s2.substr(7, 7));
	return a < b;
}
int main()
{
	string s;
	int n1, n2; cin >> n1; set<string> v1;
	vector<string>vs1;

	for (int i = 0; i < n1; i++)cin >> s, v1.insert(s);
	cin >> n2; set<string> v2;
	for (int i = 0; i < n2; i++)cin >> s, v2.insert(s);
	vector<string>vs2(v2.begin(), v2.end());

	int index = 0;
	for ( auto i:v1)
	{
		if (v2.find(i) != v2.end())index++, vs1.push_back(i);
	}
	cout << index << endl;
	if (index)
	{
		sort(vs1.begin(), vs1.end(), cmp), cout << vs1[0];
	}
	else
	{
		sort(vs2.begin(), vs2.end(), cmp), cout << vs2[0];
	}
}
