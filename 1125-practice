int main()
{
	string S, P;
	getline(cin, S); getline(cin, P);
	int n = S.size(); int m = P.size();
	vector<int>dp(m, -1);
	int bestlen = n + 1; int bestatsr = -1;
	for (int i = 0; i < n; i++)
	{
		char c = S[i];
		for (int j = m-1; j >=0 ; j--){
			if (c == P[j]){
				if (j == 0){
					dp[0] = i;
				}
				else if (dp[j - 1] != -1){
					dp[j] = max(dp[j], dp[j - 1]);
				}
			}
		}
		if (dp[m - 1] != -1) {
			int len = i - dp[m - 1] + 1;
			if (len < bestlen) {
				bestlen = len;
				bestatsr = dp[m - 1];
			}
			if (bestlen == m) break;
		}
	}
	cout << S.substr(bestatsr, bestlen);
}
//使用dp储存最小起始位置，用循环i计算长度
