bool cmp1(pair<string, string> a, pair<string, string> b) {
    int as = stoi(a.second);   int bs = stoi(b.second);
    if (as == bs) return a.first < b.first;
    return as>bs;
}

int main() {
    int n, m;
    cin >> n >> m;

    vector<pair<string, string>> students(n);  // first:准考证号, second:成绩
    for (int i = 0; i < n; i++) {
        cin >> students[i].first >> students[i].second;
    }
    sort(students.begin(), students.end(), cmp1);

    for (int i = 0; i < m; i++) {
        int type;
        string cmd;
        cin >> type >> cmd;

        printf("Case %d: %d %s\n", i + 1, type, cmd.c_str());

        if (type == 1) {
            vector<pair<string, string>> v;
            for (auto& stu : students) {
                if (stu.first[0] == cmd[0]) {
                    v.push_back(stu);
                }
            }
            if (v.empty()) {
                cout << "NA" << endl;
            }
            else {
                //sort(v.begin(), v.end(), cmp1);
                for (auto& stu : v) {
                    cout << stu.first << " " << stu.second << endl;
                }
            }
        }
        else if (type == 2) {
            int cnt = 0, sum = 0;
            for (auto& stu : students) {
                if (stu.first.substr(1, 3) == cmd) {
                    cnt++;
                    sum += stoi(stu.second);
                }
            }
            if (cnt == 0) {
                cout << "NA" << endl;
            }
            else {
                cout << cnt << " " << sum << endl;
            }
        }
        else if (type == 3) {
            map<string, int> roomCnt;
            for (auto& stu : students) {
                if (stu.first.substr(4, 6) == cmd) {
                    roomCnt[stu.first.substr(1, 3)]++;
                }
            }
            if (roomCnt.empty()) {
                cout << "NA" << endl;
            }
            else {
                vector<pair<string, int>> v(roomCnt.begin(), roomCnt.end());
                sort(v.begin(), v.end(), [](auto& a, auto& b) {
                    if (a.second == b.second) return a.first < b.first;
                    return a.second > b.second;
                    });
                for (auto& room : v) {
                    cout << room.first << " " << room.second << endl;
                }
            }
        }
    }
    
}
