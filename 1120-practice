int main() {
    int N;
    long long M; // M 可能达到 1e9
    cin >> N >> M;
    vector<long long> price(N);
    for (int i = 0; i < N; ++i) {
        cin >> price[i];
    }

    long long ans = 0;
    long long sum = 0;
    int l = 0;
    for (int r = 0; r < N; ++r) {
        sum += price[r];
        while (sum > M) {
            sum -= price[l];
            l++;
        }
        ans += (r - l + 1);
    }
    cout << ans << endl;
}
//因为价格单价递增，使用双指针，外层为右，内层l为左，求出所有方案
