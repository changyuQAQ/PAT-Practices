long long check(int a)
{
	if (a == 0)return 0;
	long long num=1;
	while (a)
	{
		num *= (a % 10) * (a % 10) * (a % 10);
		a /= 10;
	}
	int fanum=0;
	while (num)
	{
		fanum += num % 10; num /= 10;
	}
	return fanum;
}
int main()
{
	int t1, t2; cin >> t1 >> t2;
	int n = t2 - t1+1;
	vector<long long>v1;
	for (int i = t1; i <= t2; i++)v1.push_back(i);
	bool f1 = false; 
	while (!f1)
	{
		f1 = true;
		for (int i = 0; i < n; i++)
		{
			v1[i] = check(v1[i]); 
			if (v1[i] >= 10)f1 = false;
		}	
	}
	map<int, int>m1;
	for (int i = 0; i <v1.size() ; i++)m1[v1[i]]++;

    int madex = -1;

	for (auto i :m1 )if (i.second > madex)madex = i.second;

	cout << madex << endl; f1 = false;

	for (auto i : m1)
	{
		if (i.second == madex)
		{
			if (f1)cout <<" ";
			cout << i.first;
			f1 = true;
		}
	}
}
