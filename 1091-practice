int main()
{
	int n1; cin >> n1;
	for (int i = 0; i < n1; i++)
	{
		int sum; int num1; cin >> num1;
		string s1, s2; int j; bool f1 = false;
		for ( j = 1; j < 10; j++)
		{
			sum = num1 * num1 * j;
			s1 = to_string(num1);
			s2 = to_string(sum);
			string last = s2.substr(s2.size() - s1.size());
			if (last == s1)
			{
				f1 = true; break;
			}
		}
		if (f1)cout << j << " " << sum << endl;
		else cout << "No" << endl;
	}
}
