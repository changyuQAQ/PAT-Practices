int main()
{
	int index = 0;
	int num1, num2; cin >> num1 >> num2;
	for (int i = num1; i <= num2; i++)
	{
		int cc =  i * i * i -  (i - 1) * (i - 1) * (i - 1); int c = sqrt(cc);
		if (cc!=c*c) continue;
		for (int j = 2; ; j++)
		{
			int sum = (j * j + (j - 1) * (j - 1));
			if (c == sum)
			{
				cout << i << " " << j << endl, index++; break;
			}
			if (sum > c) break;
		}
	}
	if (!index)cout << "No Solution";
}
