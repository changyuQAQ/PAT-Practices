using namespace std;
struct Node {
    int data;
    int next;
};
int main() {
    int h1, h2, n;
    cin >> h1 >> h2 >> n;
    unordered_map<int, Node> nodes;
    for (int i = 0; i < n; i++) {
        int a, d, ne;
        cin >> a >> d >> ne;
        nodes[a] = { d, ne };
    }
    vector<int> l1;
    int p = h1;
    while (p != -1) {
        l1.push_back(p);
        p = nodes[p].next;
    }
    vector<int> l2;
    p = h2;
    while (p != -1) {
        l2.push_back(p);
        p = nodes[p].next;
    }
    if (l1.size() < l2.size()) {
        swap(l1, l2);
    }
    reverse(l2.begin(), l2.end());
    vector<int> res;
    int i = 0, j = 0;
    int len1 = l1.size();
    int len2 = l2.size();

    while (j < len2) {
        res.push_back(l1[i++]);
        res.push_back(l1[i++]);
        res.push_back(l2[j++]);
    }
    while (i < len1) {
        res.push_back(l1[i++]);
    }
    for (int k = 0; k < res.size(); k++) {
        if(k != res.size()-1) printf("%05d %d %05d\n", res[k], nodes[res[k]].data, res[k+1]);
        else printf("%05d %d %d", res[k], nodes[res[k]].data, -1);
    }
}
//map<int,node>储存地址，两个不同的地址分别储存长短链表，最后合并
