
int main() {
    int n;
    cin >> n;
    vector<int> w(n);
    for (int i = 0; i < n; i++) cin >> w[i];

    vector<int> milk(n, 200); // 初始最少 200

    // 从左向右
    for (int i = 1; i < n; i++) {
        if (w[i] > w[i-1])
            milk[i] = milk[i-1] + 100;
        else if (w[i] == w[i-1])
            milk[i] = milk[i-1];
    }

    // 从右向左
    for (int i = n-2; i >= 0; i--) {
        if (w[i] > w[i+1])
            milk[i] = max(milk[i], milk[i+1] + 100);
        else if (w[i] == w[i+1])
            milk[i] = max(milk[i], milk[i+1]);
    }

    int ans = 0;
    for (int x : milk) ans += x;
    cout << ans << endl;

    return 0;
}
//使用双向扫描，新知识
