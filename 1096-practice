bool check(int a)
{
	vector<int>v1;
	for (int i = 1; i <= a; i++)
	{
		if (a % i == 0)v1.push_back(i);
	}
	if (v1.size() < 4)return false;
	for (int i = 0; i < v1.size(); i++)
		for (int j = i + 1; j < v1.size(); j++)
			for (int k = j + 1; k < v1.size(); k++)
				for (int m = k + 1; m < v1.size(); m++)
					if ((v1[i] + v1[j] + v1[k] + v1[m])%a == 0)return true;
	
	return false;
}
int main()
{
	int n; cin >> n;

	for (int i = 0; i < n; i++)
	{
		int num; cin >> num;
		if (check(num))cout << "Yes" << endl;
		else cout << "No" << endl;
	}
}
