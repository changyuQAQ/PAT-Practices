//通过每次的货物通过map<int,set<int>>遍历，有一个不行进行标记，最后输出yes no


int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    
    int n, m; 
    cin >> n >> m;
    unordered_map<int, unordered_set<int>> m1;
    
    for (int i = 0; i < n; i++) {
        int a, b; 
        cin >> a >> b;
        m1[a].insert(b);
        m1[b].insert(a);
    }
    
    for (int i = 0; i < m; i++) {
        int k; 
        cin >> k;
        unordered_set<int> goods;
        for (int j = 0; j < k; j++) {
            int id; 
            cin >> id;
            goods.insert(id);
        }
        
        bool unsafe = false;
        for (int id : goods) {
            for (int conflict : m1[id]) {
                if (goods.count(conflict)) {
                    unsafe = true;
                    goto output;
                }
            }
        }
        
        output:
        cout << (unsafe ? "No" : "Yes") << '\n';
    }
}
//可以使用哈希表降低标记货物的复杂度，goto减少遍历量
