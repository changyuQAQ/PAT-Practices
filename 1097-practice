int b[105][105];
int main()
{
	int n, k, x; cin >> n >> k >> x;
	for (int i = 0; i < n; i++)
		for (int j = 0; j < n; j++)	cin >> b[i][j];
	
	int t1[105] = { 0 }; int index = 1;
	for (int i = 0; i < n; i++)
	{
		if (k+1 == index)index = 1;
		if (i + 1 & 1)
		{
			for (int j = 0; j < index ; j++)t1[j] += x; 
			for (int j = index; j < n; j++)t1[j] += b[i][j - index];
			index++;
		}
		else for (int j = 0; j < n; j++) t1[j] += b[i][j];
	}
	for (int i = 0; i <n ; i++)
	{
		cout << t1[i] ; if (i != n)cout << " ";
	}
}
//使用全局index来进行位移，t1记录位移后数据和
